.panel {
    position: absolute;
    background-color: rgba(16, 18, 22, 0.93);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    padding: 14px 16px;
}

.hud      { top: 16px; left: 16px; width: 300px; }
.settings { top: 16px; right: 16px; width: 350px; max-height: 90%; }

.title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(236, 239, 244);
    margin-bottom: 10px;
}

.section {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(122, 168, 255);
    letter-spacing: 1px;
    margin-top: 12px;
    margin-bottom: 5px;
}

.row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}
.k { font-size: 12px; color: rgb(148, 154, 164); }
.v { font-size: 12px; color: rgb(232, 236, 242); -unity-text-align: middle-right; }

.btnrow { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 27px;
    margin: 2px;
    border-radius: 7px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(220, 224, 230);
    font-size: 12px;
    transition-property: background-color;
    transition-duration: 90ms;
}
.btn:hover  { background-color: rgba(122, 168, 255, 0.22); }
.btn:active { background-color: rgba(122, 168, 255, 0.40); }
.btn.on     { background-color: rgba(122, 168, 255, 0.32); color: rgb(255, 255, 255); }

.scroll { flex-grow: 1; margin-bottom: 6px; }

.field { margin-bottom: 3px; }
.field .unity-base-field__label {
    font-size: 12px;
    color: rgb(148, 154, 164);
    min-width: 150px;
}
.field .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    padding: 2px 6px;
}
.field .unity-text-element { color: rgb(234, 238, 244); font-size: 12px; }
